{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketUnderPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "woocommerce-downloads/*",
            "woocommerce-downloads/"
          ]
        }
      }
    },
    {
      "Sid": "ObjectReadWriteAbort",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/woocommerce-downloads/*"
    },
    {
      "Sid": "OptionalDeleteForHealthChecksAndCleanup",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/woocommerce-downloads/*"
    },
    {
      "Sid": "OptionalStsIdentityCheck",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
